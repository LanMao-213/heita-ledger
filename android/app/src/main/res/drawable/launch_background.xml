<?xml version="1.0" encoding="utf-8"?>
<!-- 旧版 API 兜底（gradientRadius 不支持百分比，改用固定 dp）。
     实际构建 minSdk >= 24，会优先使用 drawable-v21 下的同名文件。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="44%"
                android:gradientRadius="370dp"
                android:startColor="#2C323E"
                android:endColor="#07080B" />
        </shape>
    </item>
</layer-list>
