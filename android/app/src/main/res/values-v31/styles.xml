<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 由系统强制画一个 SplashScreen，**关不掉**，只能指定它长什么样。
         它只接受纯色背景（给 drawable 会被忽略），所以这里显式指定与窗口同色的
         @color/app_background —— 系统闪屏、原生窗口、Flutter 首帧、主界面
         四层同色，冷启动看不出分界。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowSplashScreenBackground">@color/app_background</item>

        <!-- 图标**必须留空**（@drawable/launch_icon_none 是一个画不出东西的
             vector）。不指定这一项的话，系统会拿应用图标来画：尺寸被锁死在约
             160dp，居中一枚小标志闪一下再消失。

             应用首帧现在**没有任何标志**（启动页已删除），所以那枚图标不只是
             「小」，而是凭空多出来一个品牌元素 —— 比原来「小标志跳大标志」
             更突兀。不要改回 @mipmap/…，也不要删这个占位文件。
             test/launch_native_test.dart 有一条守卫读这里比对。 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
