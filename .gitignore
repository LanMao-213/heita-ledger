app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 签名文件：泄露等于别人能给这个 App 出升级包
# 下面这批格式一起挡住 —— 换签名商/换机器时最容易顺手拷进来
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.p8
*.der
*.mobileprovision
**/key.properties

# 三方服务的配置文件：里面带 API key / 项目号，提交即泄露
google-services.json
GoogleService-Info.plist

# 本机数据与导出：仓库已公开，这些一旦提交就是把真实账目公开
# （App 的备份是 JSON、导出是 xlsx、库是 sqlite；拷进来调试时别顺手提交）
*.db
*.db-journal
*.sqlite
*.sqlite3
*.xlsx
*.xls
黑塔消费日记-备份-*.json
auto-wipe-*.json
*备份*.json
*backup*.json

# 环境与凭证
.env
.env.*
!.env.example

# 出好的安装包：惯例放在仓库同级目录（apk/），本来就不在版本库范围内。
# 这条是兜底 —— 万一把 apk/ 挪进来或从别处拷进来，别让几十 MB 二进制跟着提交。
apk/

# Widget Preview related
.widget_preview/

# 本地 AI 助手的工作目录（会话中间产物、临时提交信息等）。
# 仓库是 public，这里面的东西没有审查价值但有泄露风险 —— 一次 `git add -A`
# 就会带进去。不需要删，忽略即可。
.workbuddy/
